# ==============================================================================
# VOYORA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (Neon PostgreSQL or any standard PostgreSQL instance)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voyora?schema=public"

# Server Port
PORT=5000

# Geoapify Places API Key (Optional: application automatically falls back to live Nominatim/Overpass API & verified database)
GEOAPIFY_API_KEY="715d707e4ce3492c8ac0a46675cdace9"

# Client API Target Base URL
VITE_API_BASE_URL="http://localhost:5000/api"

